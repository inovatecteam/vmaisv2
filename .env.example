# ─────────────────────────────────────────────────────────────────────────────
# Voluntária+ — Exemplo de variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA comite valores reais (.env* é ignorado).
# ─────────────────────────────────────────────────────────────────────────────

# ── App (público — embarcado no bundle do browser) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...                 # chave anon (pública) do Supabase
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=                    # opcional — /mapa não carrega sem ela
NEXT_PUBLIC_GOOGLE_ADS_ID=                          # opcional — ex.: AW-XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# Integração Rede Atados (scripts em docs/integracao-atados/) — NÃO usados pelo app
# ─────────────────────────────────────────────────────────────────────────────

# ── export-ongs.mjs (LADO VOLUNTÁRIA+ — lê o catálogo de ONGs do Supabase) ──
# Use a SERVICE ROLE KEY (Supabase Dashboard > Settings > API). É SECRETA: nunca
# exponha no front-end nem comite. Necessária para ler ignorando RLS na exportação.
SUPABASE_SERVICE_ROLE_KEY=                          # SECRETO — apenas local/CI seguro

# ── importar-ovp.template.mjs (LADO ATADOS — envia para a API da OVP) ────────
# Configuradas e usadas pela Atados, que roda a importação na própria plataforma.
# O Voluntária+ não precisa nem mantém estas credenciais.
OVP_API_URL=                                        # ex.: https://api.atados.com.br
OVP_API_TOKEN=                                      # token de API da OVP (SECRETO, lado Atados)

# ─────────────────────────────────────────────────────────────────────────────
# Segredos da Edge Function (configurados NO SUPABASE, não aqui):
#   RESEND_API_KEY, ADMIN_EMAIL
# Após a migração, o envio de e-mail passa a ser responsabilidade da Atados (Sparkpost).
# ─────────────────────────────────────────────────────────────────────────────
